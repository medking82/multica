# Ensure shell scripts always use LF line endings (needed for Docker on Windows)
*.sh text eol=lf
docker/entrypoint.sh text eol=lf

# Default behavior
* text=auto

# Vite's SSR hashbang matcher requires LF when this CLI is imported by Vitest.
apps/desktop/scripts/package.mjs text eol=lf

# Embedded Skill frontmatter has a platform-independent LF contract.
server/internal/service/builtin_skills/** text eol=lf
server/internal/service/builtin_skills_legacy/** text eol=lf
